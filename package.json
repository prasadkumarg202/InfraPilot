{
  "name": "infrapilot-web",
  "version": "1.0.0",
  "private": true,
  "description": "Infrapilot \u2014 marketing site and design system. Next.js 15, React 19, TypeScript.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "analyze": "ANALYZE=true next build",
    "og": "node tools/og.mjs",
    "static": "bash tools/run.sh",
    "shoot": "node tools/shoot.mjs",
    "test:a11y": "node tools/a11y.mjs",
    "verify": "node tools/verify.mjs",
    "inline": "node tools/inline.mjs"
  },
  "dependencies": {
    "next": "15.4.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "@tanstack/react-query": "^5.62.0",
    "zustand": "^5.0.3",
    "motion": "^12.0.0",
    "framer-motion": "^12.0.0",
    "@xyflow/react": "^12.4.0",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "recharts": "^2.15.0",
    "lucide-react": "^0.474.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@next/mdx": "^15.1.0",
    "@mdx-js/react": "^3.1.0",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/d3-scale": "^4.0.8",
    "@types/d3-shape": "^3.1.7",
    "typescript": "^5.7.0",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.4.6",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "postcss": "^8.5.1",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.24.0",
    "playwright": "^1.49.0"
  }
}
